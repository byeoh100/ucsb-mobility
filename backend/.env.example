# Local development settings. Copy this file to .env (same folder) and edit.
# Django loads .env automatically on startup. .env is git-ignored; never commit it.

DJANGO_DEBUG=true

# Shows a "sign in as any email" form so you can test roles without Google.
DEV_LOGIN=true

# Your email. Added to the admin list on first sign-in while the list is empty.
BOOTSTRAP_ADMIN_EMAIL=you@ucsb.edu

# From Google Cloud Console (see README). Leave blank to use DEV_LOGIN only.
GOOGLE_CLIENT_ID=

# Dispatch's phone number, shown on rider pages.
DISPATCH_PHONE=
